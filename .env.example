# Domain for Traefik routing and Let's Encrypt SSL certificate
DOMAIN=client1.com

# Email for Let's Encrypt ACME certificate registration/renewal
ACME_EMAIL=you@example.com

# Public-facing URL of the site (exposed to client-side code)
NEXT_PUBLIC_SITE_URL=

# Server-side canonical URL for sitemaps and SEO
SITE_URL=

# Website name used in blog post meta titles
SITE_NAME=

# Default author name for blog SEO metadata
AUTHOR_NAME=

# Webhook URL (e.g. n8n) contact form submissions
FORM_WEBHOOK_URL=

# Webhook URL that receives negative review funnel submissions
BAD_REVIEW_WEBHOOK_URL=

# Direct URL to your Google Business Profile review page
GOOGLE_REVIEW_LINK=

# Webhook URL for client to send request for reviews to customers (name, phone, email)
REVIEW_REQUEST_WEBHOOK_URL=

# n8n webhook url to update database when the link is clicked
N8N_CONTACT_NOTIFY_URL=